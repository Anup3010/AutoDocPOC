#!/bin/sh
export GEMINI_API_KEY=$(grep "^GEMINI_API_KEY=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)
export CONFLUENCE_URL=$(grep "^CONFLUENCE_URL=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)
export CONFLUENCE_USER=$(grep "^CONFLUENCE_USER=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)
export CONFLUENCE_TOKEN=$(grep "^CONFLUENCE_TOKEN=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)
export CONFLUENCE_PAGE_ID=$(grep "^CONFLUENCE_PAGE_ID=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "master" ] || [ "$CURRENT_BRANCH" = "main" ]; then
  export AUTODOC_MODE=both
else
  export AUTODOC_MODE=pr_only
fi
echo "[AutoDoc] Branch: $CURRENT_BRANCH Mode: $AUTODOC_MODE"
"C:/Users/anup.shembbade/AppData/Local/Programs/Python/Python313/python.exe" -m doc_generator.generator "$(cd "$(dirname "$0")/../.." && pwd)"