#!/bin/sh
export GEMINI_API_KEY=$(grep "^GEMINI_API_KEY=" "$(cd "$(dirname "$0")/../.." && pwd)/.env" | cut -d'=' -f2)

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" = "master" ]; then
    export AUTODOC_MODE=both
    echo "[AutoDoc] Master branch — generating full doc + PR analysis"
else
    export AUTODOC_MODE=pr_only
    echo "[AutoDoc] Feature branch — generating PR analysis only"
fi

"C:/Users/anup.shembade/Appად/Local/Programs/Python/Python313/python.exe" -m doc_generator.generator "$(cd "$(dirname "$0")/../.." && pwd)"