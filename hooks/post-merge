#!/usr/bin/env python3
import os
import sys
import subprocess

THIS_FILE = os.path.abspath(__file__)
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(THIS_FILE)))

env_path = os.path.join(REPO_ROOT, ".env")
if os.path.exists(env_path):
    with open(env_path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, val = line.partition("=")
                os.environ.setdefault(key.strip(), val.strip())

GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY", "")
PYTHON_EXE = "C:/Users/anup.shembade/AppData/Local/Programs/Python/Python313/python.exe"

if not GEMINI_API_KEY:
    print("[AutoDoc] WARNING: GEMINI_API_KEY not set")
    sys.exit(0)

print("\n[AutoDoc] Merge detected - generating full documentation...")

env = os.environ.copy()
env["GEMINI_API_KEY"]     = GEMINI_API_KEY
env["AUTODOC_MODE"]       = "both"
env["AUTODOC_OUTPUT_DIR"] = os.path.join(REPO_ROOT, "generated_docs")
env["PYTHONPATH"]         = REPO_ROOT

try:
    result = subprocess.run(
        [PYTHON_EXE, "-m", "doc_generator.generator", REPO_ROOT],
        cwd=REPO_ROOT,
        env=env,
        timeout=300
    )
    if result.returncode == 0:
        print("[AutoDoc] Done! View at: http://localhost:5000")
    else:
        print("[AutoDoc] Generation had errors.")
except Exception as e:
    print(f"[AutoDoc] Error: {e}")

sys.exit(0)